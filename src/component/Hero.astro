<section class="hero relative flex min-h-96 flex-wrap-reverse justify-between p-20">
  <div class="flex flex-col self-center gap-3">
    <h1 class="text-5xl font-bold text-1">ukitouch</h1>
    <span class="text-2xl text-2">The extensible P2P workspace.</span>
  </div>

  <div
    id="icon-box"
    class="relative z-20 aspect-square w-[clamp(300px,42vw,400px)]"
  >
    <svg viewBox="0 0 600 600" xmlns="http://www.w3.org/2000/svg">

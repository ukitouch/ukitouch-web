---
import "../styles/theme.css";
import Logo from "./Logo.astro";
---

<div id="intro-overlay" class="fixed inset-0 z-10 bg-overall"></div>
<section
  id="hero"
  class="relative flex min-h-96 min-x-96 flex-wrap-reverse justify-around gap-8 px-[clamp(1.5rem,5vw,5rem)]"
>
  <div class="flex flex-col self-center gap-3">
    <h1 class="text-5xl text-center font-bold text-1">ukitouch</h1>
    <span class="text-2xl text-2">The extensible P2P workspace.</span>
  </div>

  <div
    id="icon-box"
    class="relative z-20 aspect-square w-[clamp(300px,42vw,400px)]"
  >
    <Logo anim={true} />
  </div>
</section>

<script>
  const hero = document.querySelector("#hero") as HTMLElement;
  const box = document.querySelector("#icon-box") as HTMLElement;
  const centerBall = box.querySelector("#center-ball") as HTMLElement;
  const overlay = document.querySelector("#intro-overlay") as HTMLElement;

  let finished = false;
  const reduceMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;

  if (reduceMotion) {
    skipIntro();
  } else {
    centerIcon();

    box.addEventListener(
      "transitionend",
      (e) => {
        if (e.target !== box || e.propertyName !== "transform") return;

        box.classList.remove("move");
        finishAnim();
      },
      { once: true },
    );

    centerBall.addEventListener(
      "animationend",
      () => {
        box.classList.add("move");
        overlay.classList.add("fade");

        requestAnimationFrame(() => {
          box.style.transform = "translate(0px, 0px)";
        });
      },
      { once: true },
    );

    document.addEventListener("click", skipIntro);
    document.addEventListener("keydown", skipIntro);
  }

  overlay.addEventListener(
    "transitionend",
    (e) => {
      if (e.target !== overlay || e.propertyName !== "opacity") return;

      overlay.classList.add("hidden");
      finishAnim();
    },
    { once: true },
  );

  // fn
  function finishAnim() {
    finished = true;

    box.classList.remove("z-20");
    document.removeEventListener("click", skipIntro);
    document.removeEventListener("keypress", skipIntro);
  }

  function skipIntro() {
    if (finished) return;

    hero.classList.add("intro-skip");
    box.style.transform = "translate(0px, 0px)";
    overlay.classList.add("hidden");

    finishAnim();
  }

  function centerIcon() {
    const rect = box.getBoundingClientRect();
    const dx = window.innerWidth / 2 - (rect.left + rect.width / 2);
    const dy = window.innerHeight / 2 - (rect.top + rect.height / 2);

    box.style.transform = `translate(${dx}px, ${dy}px)`;
  }
</script>

<style scoped>
  #icon-box.move {
    transition: transform 1.5s cubic-bezier(0.45, 0, 0.55, 1);
  }

  #intro-overlay {
    opacity: 1;
    transition: opacity 1.5s cubic-bezier(0.45, 0, 0.55, 1);
  }

  #intro-overlay.fade {
    opacity: 0;
  }

  .intro-skip #icon-box,
  .intro-skip #intro-overlay {
    transition: none !important;
  }

  .intro-skip :global(.m-peer) {
    animation: none !important;
    stroke-dashoffset: 0;
    opacity: 1;
  }

  .intro-skip :global(.anim-ball) {
    animation: none !important;
    transform: scale(1);
  }

  @media (prefers-reduced-motion: reduce) {
    #intro-overlay,
    #icon-box {
      transition: none;
    }

    :global(.m-peer) {
      animation: none;
      stroke-dashoffset: 0;
      opacity: 1;
    }

    :global(.anim-ball) {
      animation: none;
      transform: scale(1);
    }
  }
</style>

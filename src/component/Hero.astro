    </svg>
  </div>
</section>

<script>
  const hero = document.querySelector(".hero") as HTMLElement;
  const box = document.querySelector("#icon-box") as HTMLElement;
  const centerBall = box.querySelector(".center-ball") as HTMLElement;
  const overlay = document.querySelector("#intro-overlay") as HTMLElement;

  const reduceMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;

  let moveEnded = false;
  let fadeEnded = false;
  let finished = false;
  let started = false;

  function hideOverlayWhenFinished() {
    if (!moveEnded || !fadeEnded || finished) return;

    finished = true;
    document.removeEventListener("click", skipIntro);
  }

  function startMove() {
    if (started || finished) return;
    started = true;

    box.classList.add("move");
    overlay.classList.add("fade");

    requestAnimationFrame(() => {
      box.style.transform = "translate(0px, 0px)";
    });
  }

  function onIconTransitionEnd(e: TransitionEvent) {
    if (e.target !== box || e.propertyName !== "transform") return;

    moveEnded = true;
    box.classList.remove("move");
    hideOverlayWhenFinished();
  }

  function skipIntro() {
    if (finished) return;

    hero.classList.add("intro-skip");
    box.style.transform = "translate(0px, 0px)";
    overlay.classList.add("hidden");

    finished = true;
    document.removeEventListener("click", skipIntro);
  }

  function centerIcon() {
    const rect = box.getBoundingClientRect();
    const dx = window.innerWidth / 2 - (rect.left + rect.width / 2);
    const dy = window.innerHeight / 2 - (rect.top + rect.height / 2);

    box.style.transform = `translate(${dx}px, ${dy}px)`;
  }

  if (reduceMotion) {
    skipIntro();
  } else {
    centerIcon();

    box.addEventListener("transitionend", onIconTransitionEnd);
    centerBall.addEventListener("animationend", startMove, { once: true });
    document.addEventListener("click", skipIntro);
  }

  overlay.addEventListener("transitionend", (e) => {
    if (e.target !== overlay || e.propertyName !== "opacity") return;

    overlay.classList.add("hidden");
    fadeEnded = true;
    hideOverlayWhenFinished();
  });
</script>

<style scoped>
  #icon-box.move {
    transition: transform 1.5s cubic-bezier(0.45, 0, 0.55, 1);
  }

  .pen {
    fill: none;
    stroke: white;
    stroke-width: 70;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 1000 1100;
    stroke-dashoffset: 1100;
    animation: sweep 1.5s cubic-bezier(0.45, 0, 0.55, 1) both;
  }

  .pen-blue {
    animation-delay: 0.2s;
  }

  .center-ball {
    transform-box: fill-box;
    transform-origin: center;
    transform: scale(0);
    animation: grow 0.6s cubic-bezier(0.45, 0, 0.55, 1) 1.4s both;
  }

  #intro-overlay {
    opacity: 1;
    transition: opacity 1.5s cubic-bezier(0.45, 0, 0.55, 1);
  }

  #intro-overlay.fade {
    opacity: 0;
  }

  .intro-skip #icon-box,
  .intro-skip #intro-overlay {
    transition: none !important;
  }

  .intro-skip .pen {
    animation: none !important;
    stroke-dashoffset: 0;
    opacity: 1;
  }

  .intro-skip .center-ball {
    animation: none !important;
    transform: scale(1);
  }

  @keyframes sweep {
    0% {
      stroke-dashoffset: 1100;
      opacity: 0;
    }

    20% {
      opacity: 0;
    }

    40% {
      opacity: 1;
    }

    100% {
      stroke-dashoffset: 0;
      opacity: 1;
    }
  }

  @keyframes grow {
    from {
      transform: scale(0);
    }

    to {
      transform: scale(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #intro-overlay,
    #icon-box {
      transition: none;
    }

    .pen {
      animation: none;
      stroke-dashoffset: 0;
      opacity: 1;
    }

    .center-ball {
      animation: none;
      transform: scale(1);
    }
  }
</style>
